{
  "name": "themisflow",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "version:gen": "node scripts/generate-version.mjs",
    "prebuild": "node scripts/generate-version.mjs",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "test:golden": "node --test reference/fixtures/*.test.mjs",
    "test": "npm run test -w packages/core",
    "test:api": "npm run test -w apps/api",
    "build": "npm run build -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "screenshot:stitch": "node scripts/capture-stitch-screenshots.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "xlsx": "0.18.5"
  }
}
