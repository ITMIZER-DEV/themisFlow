# ══════════════════════════════════════════════════════════════════════════════
# ThemisFlow — .env (Configuração de Produção para o Cliente Piloto)
# ══════════════════════════════════════════════════════════════════════════════

# ── Identificação do Cliente Piloto ──────────────────────────────────────────
# Nome fantasia da empresa ou supermercado piloto
PILOT_CLIENT_NAME=Supermercado Piloto
PILOT_CLIENT_CNPJ=

# ── Banco de Dados PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=themisflow
POSTGRES_USER=itmizer
# Senha forte para o banco de dados do cliente piloto:
POSTGRES_PASSWORD=Th3m1s_DB_2026!
POSTGRES_PORT=5432

# ── Segurança / JWT ──────────────────────────────────────────────────────────
# Chave de assinatura dos tokens de sessão
JWT_SECRET=7f2c1b9e4a8d3f6c0e5b2a9d1f8c7e4b3a6d9f2c1b8e5a3d7f0c4b2e9a1d6c

# ── Usuário Administrador (Criado no Primeiro Startup) ───────────────────────
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@themisflow.local
ADMIN_SENHA=ThemisFlow@2026

# ── Usuário Operador Financeiro (Criado no Primeiro Startup) ──────────────────
OPERADOR_NOME=Operador Financeiro
OPERADOR_EMAIL=operador@themisflow.local
OPERADOR_SENHA=Operador@2026

# ── Ambiente ─────────────────────────────────────────────────────────────────
NODE_ENV=production
CORS_ORIGIN=*
