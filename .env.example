# ──────────────────────────────────────────────────────────────────────────────
# ThemisFlow — .env.example
# Copie para .env e preencha os valores antes de subir o stack.
# No Portainer, configure estas variáveis na seção "Environment Variables".
# ──────────────────────────────────────────────────────────────────────────────

# ── Domínio ────────────────────────────────────────────────────────────────
# Domínio onde o ThemisFlow será acessado.
# O cliente deve criar um registro A (ou CNAME) apontando para o IP do servidor.
THEMIS_DOMAIN=themisflow.empresa.com.br

# ── Banco de dados ─────────────────────────────────────────────────────────
POSTGRES_USER=itmizer
# ⚠️  Troque por uma senha forte e única!
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA

# Porta externa do PostgreSQL (para acesso via DBeaver/pgAdmin)
POSTGRES_PORT=5432

# Prisma — usado localmente fora do Docker (npm run dev:api)
DATABASE_URL=postgresql://itmizer:TROQUE_ESTA_SENHA@localhost:5432/themisflow

# ── JWT ────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET=GERE_UM_SEGREDO_AQUI

# ── Usuário administrador ──────────────────────────────────────────────────
# Criado automaticamente no primeiro startup (seed idempotente).
# ⚠️  Altere a senha antes de subir em produção!
ADMIN_EMAIL=admin@empresa.com.br
ADMIN_SENHA=Mudar@123

# ── Traefik ────────────────────────────────────────────────────────────────
# Nome da rede Docker do Traefik (criada pelo stack traefik)
TRAEFIK_NETWORK=traefik_public

# Nome do cert resolver configurado no Traefik (padrão: letsencrypt)
TRAEFIK_CERTRESOLVER=letsencrypt

# ── Ambiente ───────────────────────────────────────────────────────────────
NODE_ENV=production

# ── CORS (dev local) ───────────────────────────────────────────────────────
# Usado apenas ao rodar a API fora do Docker (npm run dev:api)
CORS_ORIGIN=http://localhost:5173
